{
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run --unstable -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "gmi": "deno run -A tasks/gmi.ts",
    "fmt": "deno fmt **/*.ts **/*.tsx",
    "lint": "deno lint **/*.ts **/*.tsx",
    "check": "deno fmt --check **/*.ts **/*.tsx && deno task lint && deno check **/*.ts **/*.tsx"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "types": [
      "lume/types.ts"
    ]
  },
  "imports": {
    "@std/csv": "jsr:@std/csv@1.0.6",
    "lume/": "https://deno.land/x/lume@v3.0.4/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "lint": {
    "plugins": [
      "https://deno.land/x/lume@v3.0.4/lint.ts"
    ],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
